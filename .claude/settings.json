{
  "hooks": {
    "SessionEnd": [
      {"hooks": [{"type": "command", "command": "/srv/acme-demo/foreman/hooks/session_end.sh"}]}
    ],
    "Stop": [
      {"hooks": [{"type": "command", "command": "/srv/acme-demo/foreman/hooks/stop.sh"}]}
    ]
  },
  "permissions": {
    "allow": [
      "Bash(python3 -m pytest:*)",
      "Bash(python3 -m collectors.validate:*)",
      "Bash(git status:*)",
      "Bash(git ls-files:*)",
      "Bash(git log:*)",
      "Bash(git diff:*)",
      "Bash(grep:*)",
      "Bash(gh api:*)"
    ]
  }
}
