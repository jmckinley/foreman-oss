__pycache__/
*.pyc
# Local spool for cadence partials (drained into receipts, never committed here)
spool/
*.partial.json
# Secrets (§19): only sops-encrypted *.sops.yaml may be committed. Plaintext and the
# per-project injected env files never are.
.env
secrets/*
!secrets/*.sops.yaml
!secrets/.gitkeep
!secrets/expiry.yaml
.vercel
.env*.local

.playwright-mcp/
.coverage
.DS_Store

