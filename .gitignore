__pycache__/
*.pyc
# Local spool for cadence partials (drained into receipts, never committed here)
spool/
*.partial.json
# Secrets (§19): only sops-encrypted *.sops.yaml may be committed. Plaintext and the
# per-project injected env files never are.
.env
secrets/*
!secrets/*.sops.yaml
!secrets/.gitkeep
!secrets/expiry.yaml
.vercel
.env*.local

.playwright-mcp/
.coverage
.DS_Store


# Screencast build intermediates — only the storyboard, final .mp4 and caption sidecars are
# tracked (see screencast/README.md). Audio is cached per segment id; frames/clips are per build.
screencast/audio/
screencast/frames/
screencast/clips/
screencast/*.webm
scripts/screencast/node_modules/
scripts/screencast/package-lock.json
