# Foreman runtime env — sourced by the scheduler launchd agent and the collect path
# (scripts/refresh-hosted.sh). No secrets here (this file is committed); secrets live in the
# sops store. Values take effect on the next scheduler tick / collect run.

# --- Quota guard (SPEC §16.3) -------------------------------------------------------------
# FOREMAN_QUOTA_CMD prints JSON {pct_used, plan, window_resets}; below 15% headroom the guard
# defers non-red cadences. collectors.quota_probe derives headroom from local Claude Code
# transcripts (tokens used in the current 5-hour window / your plan's window budget).
FOREMAN_QUOTA_CMD="python3 -m collectors.quota_probe"

# Your plan's approximate total-token budget per 5-hour window — the ONE operator-specific knob.
# The probe reports pct_used = window_tokens / this. Leave BLANK to keep the guard inert (the
# probe emits nothing, so Foreman never defers work on a guessed number). Set it to your plan's
# ~5h token ceiling to turn deferral on. Rough references: Pro ≈ 2–3M, Max 5× ≈ 12–15M,
# Max 20× ≈ 45–60M tokens per 5h window — tune to what your own usage tool reports.
FOREMAN_PLAN_TOKEN_LIMIT=

# --- Notifications (collectors/notify.py) ------------------------------------------------
# Push reds + queued approvals to where you already are, so you don't have to remember to open
# the board. All optional: with none set, notifications are inert. NEVER commit a real webhook
# URL — it is a secret; set these in your shell/launchd env, not in this committed file.
#   FOREMAN_NOTIFY_WEBHOOK   Slack/Discord/generic incoming-webhook URL (channel auto-detected)
#   FOREMAN_NOTIFY_CHANNEL   force slack|discord|generic|file|stdout (else inferred from the URL)
#   FOREMAN_NOTIFY_FILE      append messages to a local file instead of a webhook (no secret)
#   FOREMAN_DASHBOARD_URL    base URL used for the deep link in each message (default 127.0.0.1:8787)
# FOREMAN_NOTIFY_WEBHOOK=
# FOREMAN_DASHBOARD_URL=http://127.0.0.1:8787

# --- Auto-remediation (collectors/remediate.py) ------------------------------------------
# Off by default. Opt a project in with `auto_remediate: true` (or a list of loop slugs) in
# registry.yaml, and declare `remediation: {enabled: true}` on the cadence. When an opted-in
# loop goes red, Foreman dispatches a scoped fix loop (worktree-isolated, opens a PR); the PR
# still waits for the approve_push human gate. Capped at remediation.max_attempts per red streak.
