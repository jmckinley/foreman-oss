# Foreman telemetry env block (C2, SPEC.md section 9).
#
# Push this to every host. Claude Code reads telemetry configuration ONLY at startup, so a
# change takes effect on the next session, not the running one.
#
# foreman.host must be set per host (mbp | mini | vps | cloud). foreman.project is optional
# but lets C2 attribute telemetry_day rows to a project directly; without it the row is keyed
# project=unknown until joined to a C1 session by session.id.
#
# OTEL_EXPORTER_OTLP_PROTOCOL must be http/json: the Foreman receiver (collectors/telemetry.py)
# accepts OTLP/HTTP JSON, not protobuf.

CLAUDE_CODE_ENABLE_TELEMETRY=1
OTEL_METRICS_EXPORTER=otlp
OTEL_LOGS_EXPORTER=otlp
OTEL_EXPORTER_OTLP_PROTOCOL=http/json
OTEL_EXPORTER_OTLP_ENDPOINT=http://mini.tailnet.example:4318
OTEL_RESOURCE_ATTRIBUTES=foreman.host=mbp
